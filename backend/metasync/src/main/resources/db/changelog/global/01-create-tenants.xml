<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <changeSet id="1-create-tenants-table" author="metasync-team">
        <createTable tableName="tenants" schemaName="public">
            <column name="tenant_id" type="UUID">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="tenant_name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" />
            </column>
            <column name="tenant_alias" type="VARCHAR(50)">
                <constraints nullable="false" unique="true" />
            </column>
            <column name="schema_name" type="VARCHAR(63)">
                <constraints nullable="false" unique="true" />
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false" />
            </column>
            <column name="plan" type="VARCHAR(20)" defaultValue="FREE">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>